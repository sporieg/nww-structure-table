{
  "id": "nww-lancer-alt-structure",
  "title": "LANCER Alternative Structure",
  "description": "Implements nww alternative structure rulesets for Lancer",
  "version": "#{VERSION}#",
  "library": "false",
  "compatibility": {
    "minimum": 11,
    "verified": 13
  },
  "authors": [
    {
      "name": "George Sporie",
      "url": "https://github.com/sporieg/nww-structure-table"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "lancer",
        "type": "system",
        "compatibility": {
          "minimum": "3.0.0"
        }
      }
    ],
    "requires": [
      {
        "id": "lancer-automations",
        "type": "module",
        "url": "https://github.com/Agraael/lancer-automations",
        "manifest": "https://github.com/Agraael/lancer-automations/releases/latest/download/module.json",
        "download": "https://github.com/Agraael/lancer-automations/releases/latest/download/module.zip"
      }
    ]
  },
  "esmodules": ["scripts/structure.js", "scripts/stress.js"],
  "styles": [],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "language/en.json"
    }
  ],
  "url": "#{URL}#",
  "manifest": "#{MANIFEST}#",
  "download": "#{DOWNLOAD}#",
  "license": "LICENSE",
  "readme": "README.md",
  "media": [
    {
      "type": "icon",
      "url": "https://avatars2.githubusercontent.com/u/71292812?s=400&u=ccdb4eeb7abf551ca8f314e5a9bfd0479a4d3d41&v=4"
    }
  ]
}
